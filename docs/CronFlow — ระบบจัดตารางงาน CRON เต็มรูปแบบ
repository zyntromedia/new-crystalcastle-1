                return True
            # ตรวจสิทธิ์เฉพาะ
            row = conn.execute(f"""
                SELECT {field} FROM job_permissions
                WHERE job_id=? AND user_id=?
            """, (job_id, user_id)).fetchone()
            return bool(row and row[0])

    def assign_permission(self, job_id: str, user_id: str,
                          can_read=1, can_write=0, can_execute=0):
        """มอบสิทธิ์ให้ผู้ใช้"""
