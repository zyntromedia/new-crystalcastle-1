                     schedule_type, created_at, updated_at)
                    VALUES (%s, %s, %s, %s, %s, %s, %s, %s)
                """, (job_id, name, schedule_expr, handler_type,
                      json.dumps(handler_config),
                      kwargs.get("schedule_type", "cron"), now, now))
            conn.commit()
        return job_id

