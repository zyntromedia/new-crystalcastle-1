"""
CronFlow — Alert / Webhook Notifier
แจ้งเตือนเมื่องานล้ม · หมดเวลา · กลับมาทำงาน
"""

import httpx
import json
from datetime import datetime
from typing import Optional, List, Dict
from cronflow_db import CronFlowDB


class AlertRule:
    """กฎการแจ้งเตือน"""
    def __init__(self, match_statuses: List[str], webhook_url: str,
                 min_retry: int = 0, cooldown_minutes: int = 5):
        self.match_statuses = match_statuses
        self.webhook_url = webhook_url
        self.min_retry = min_retry
        self.cooldown = cooldown_minutes * 60
        self._last_sent: Dict[str, float] = {}

    def should_send(self, job_id: str, status: str, attempt: int) -> bool:
        if status not in self.match_statuses:
            return False
        if attempt < self.min_retry:
            return False
        now = datetime.utcnow().timestamp()
        if now - self._last_sent.get(job_id, 0) < self.cooldown:
            return False
        self._last_sent[job_id] = now
        return True


class AlertManager:
    def __init__(self, db: CronFlowDB):
        self.db = db
        self.rules: List[AlertRule] = []
        self._load_rules_from_db()

    def _load_rules_from_db(self):
        """โหลดกฎจากตาราง settings"""
        with self.db._connect() as conn:
            row = conn.execute("SELECT value FROM settings WHERE key='alert_rules'").fetchone()
            if row and row[0]:
                data = json.loads(row[0])
                for r in data:
                    self.rules.append(AlertRule(**r))

    def register_rule(self, rule: AlertRule):
        self.rules.append(rule)
        self._save_rules()

    def _save_rules(self):
        data = [{
            "match_statuses": r.match_statuses,
            "webhook_url": r.webhook_url,
            "min_retry": r.min_retry,
            "cooldown_minutes": r.cooldown // 60
        } for r in self.rules]
        with self.db._connect() as conn:
            conn.execute("REPLACE INTO settings (key, value) VALUES ('alert_rules', ?)",
                        (json.dumps(data, ensure_ascii=False),))

    def notify(self, job_id: str, run_id: str, status: str,
               message: str = "", attempt: int = 1, **kwargs):
        """ส่งการแจ้งเตือนถ้าตรงกฎ"""
        with self.db._connect() as conn:
            job = conn.execute("SELECT * FROM jobs WHERE job_id=?", (job_id,)).fetchone()
            if not job:
                return

        payload = {
            "event": "job_" + status,
            "job_id": job_id,
            "job_name": job["name"],
            "run_id": run_id,
            "status": status,
            "attempt": attempt,
            "message": message,
            "timestamp": datetime.utcnow().isoformat() + "Z",
            "schedule_expr": job["schedule_expr"]
        }

        sent = False
        for rule in self.rules:
            if rule.should_send(job_id, status, attempt):
                try:
                    httpx.post(
                        rule.webhook_url,
                        json=payload,
                        timeout=10,
                        headers={"X-CronFlow-Signature": self._sign(payload)}
                    )
                    sent = True
                except Exception as e:
                    print(f"⚠️ ส่งแจ้งเตือนล้มเหลว: {e}")

        # บันทึกลงตาราง alerts
        with self.db._connect() as conn:
            conn.execute("""
                INSERT INTO alerts (alert_id, job_id, type, message)
                VALUES (?, ?, ?, ?)
            """, (f"alert_{datetime.utcnow().strftime('%Y%m%d%H%M%S')}",
                  job_id, status, message))

        return sent

    def _sign(self, payload: Dict) -> str:
        """ลายเซ็นความปลอดภัย — ใส่ SECRET ในสภาพแวดล้อม"""
        import hmac, hashlib, os
        secret = os.getenv("ALERT_WEBHOOK_SECRET", "").encode()
        if not secret:
            return ""
        return hmac.new(secret, json.dumps(payload, sort_keys=True).encode(), hashlib.sha256).hexdigest()
