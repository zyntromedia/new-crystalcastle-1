"""
CronFlow — Scheduler & CRON Parser
แยกเวลา · คำนวณรอบถัดไป · รันงานตามกำหนดเวลา
"""

import re
from datetime import datetime, timedelta
from typing import Optional, List, Tuple, Dict
import croniter


class CronParser:
    """แปลงนิพจน์ CRON → คำนวณเวลาที่จะรันถัดไป"""

    @staticmethod
    def validate(expr: str) -> bool:
        """ตรวจสอบรูปแบบ CRON ถูกต้องหรือไม่"""
        try:
            croniter.croniter(expr)
            return True
        except (croniter.CroniterError, ValueError):
            return False

    @staticmethod
    def parse(expr: str, base_time: Optional[datetime] = None, timezone: str = "UTC") -> datetime:
        """คืนเวลาที่จะรันครั้งถัดไป"""
        base = base_time or datetime.utcnow()
        try:
            it = croniter.croniter(expr, base, ret_type=datetime)
            return it.get_next()
        except Exception as e:
            raise ValueError(f"CRON expression ไม่ถูกต้อง: {expr} — {e}")

    @staticmethod
    def list_upcoming(expr: str, count: int = 5, base_time: Optional[datetime] = None) -> List[datetime]:
        """แสดงเวลาที่จะรันข้างหน้า N ครั้ง"""
        base = base_time or datetime.utcnow()
        it = croniter.croniter(expr, base, ret_type=datetime)
        return [it.get_next() for _ in range(count)]


class SchedulerEngine:
    """ตัวจัดตารางเวลา — ค้นหา+รันงานที่ถึงเวลา"""

    def __init__(self, db, worker_id: str = "cronflow-worker-01"):
        self.db = db
        self.worker_id = worker_id
        self._running = False

    def get_ready_jobs(self) -> List[Dict]:
        """ดึงรายการงานที่ถึงเวลาและยังไม่มีใครรัน"""
        jobs = self.db.get_due_jobs()
        valid_jobs = []
        for job in jobs:
            try:
                next_run = CronParser.parse(job["schedule_expr"])
                job["next_run_at"] = next_run.isoformat()
                valid_jobs.append(job)
            except ValueError as e:
                self.db.update_job_status(job["job_id"], "error", str(e))
        return valid_jobs

    def execute_job(self, job: Dict) -> Tuple[str, bool]:
        """รันงานตามประเภท: shell / python / api"""
        import json
        import subprocess
        import asyncio
        import httpx

        job_id = job["job_id"]
        config = json.loads(job["handler_config"])

        # เริ่มบันทึกการรัน + ล็อก
        run_id = self.db.start_run(job_id, self.worker_id)

        try:
            if job["handler_type"] == "shell":
                result = subprocess.run(
                    config["command"],
                    shell=True,
                    capture_output=True,
                    text=True,
                    timeout=config.get("timeout", 300)
                )
                output = result.stdout + result.stderr
                success = result.returncode == 0
                self.db.finish_run(
                    run_id,
                    "success" if success else "failed",
                    output=output,
                    error_message="" if success else f"Exit code: {result.returncode}",
                    exit_code=result.returncode
                )

            elif job["handler_type"] == "api":
                resp = httpx.request(
                    method=config.get("method", "GET"),
                    url=config["url"],
                    params=config.get("params"),
                    json=config.get("body"),
                    timeout=config.get("timeout", 30)
                )
                self.db.finish_run(
                    run_id,
                    "success" if resp.is_success else "failed",
                    output=resp.text[:2000],
                    error_message="" if resp.is_success else f"HTTP {resp.status_code}",
                    exit_code=resp.status_code
                )

            elif job["handler_type"] == "python":
                # เรียกฟังก์ชัน/โมดูลที่กำหนด
                mod_name, func_name = config["entrypoint"].rsplit(".", 1)
                import importlib
                mod = importlib.import_module(mod_name)
                func = getattr(mod, func_name)
                result = func(**config.get("kwargs", {}))
                self.db.finish_run(
                    run_id,
                    "success",
                    output=str(result)[:2000]
                )

            return run_id, True

        except subprocess.TimeoutExpired:
            self.db.finish_run(run_id, "timeout", error_message="Job timed out")
            return run_id, False
        except Exception as e:
            self.db.finish_run(run_id, "failed", error_message=str(e))
            return run_id, False

    async def run_loop(self, interval: int = 10):
        """วนตรวจสอบทุก N วินาที"""
        self._running = True
        while self._running:
            jobs = self.get_ready_jobs()
            for job in jobs:
                self.execute_job(job)
            await asyncio.sleep(interval)

    def stop(self):
        self._running = False
