import os
import json
from datetime import datetime
from typing import Optional, Dict, List
import psycopg
from psycopg.rows import dict_row


class CronFlowDB:
    def __init__(self, dsn: str = None):
        self.dsn = dsn or os.getenv("DATABASE_URL", "postgresql://user:pass@localhost/cronflow")
        self._init_schema()

    def _connect(self):
        conn = psycopg.connect(self.dsn, row_factory=dict_row)
        return conn

    def _init_schema(self):
        with self._connect() as conn, conn.cursor() as cur:
            cur.execute("""
CREATE TABLE IF NOT EXISTS jobs (
    job_id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT DEFAULT '',
    schedule_expr TEXT NOT NULL,
    schedule_type TEXT NOT NULL DEFAULT 'cron'
        CHECK (schedule_type IN ('cron','interval','date','once')),
    timezone TEXT DEFAULT 'UTC',
    handler_type TEXT NOT NULL,
    handler_config TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'active'
        CHECK (status IN ('active','paused','disabled','error')),
    last_run_at TIMESTAMP,
    next_run_at TIMESTAMP,
    last_status TEXT,
    retry_count INTEGER DEFAULT 0,
    max_retries INTEGER DEFAULT 3,
    timeout_sec INTEGER DEFAULT 300,
    created_by TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS job_runs (
    run_id TEXT PRIMARY KEY,
    job_id TEXT NOT NULL REFERENCES jobs(job_id) ON DELETE CASCADE,
    status TEXT NOT NULL DEFAULT 'running'
        CHECK (status IN ('running','success','failed','timeout','skipped')),
    started_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    finished_at TIMESTAMP,
    duration_ms INTEGER,
    exit_code INTEGER,
    output TEXT,
    error_message TEXT,
    attempt INTEGER DEFAULT 1,
    worker_id TEXT
);
CREATE INDEX IF NOT EXISTS idx_job_runs_job_id ON job_runs(job_id);
CREATE INDEX IF NOT EXISTS idx_job_runs_status ON job_runs(status);
CREATE INDEX IF NOT EXISTS idx_job_runs_started ON job_runs(started_at DESC);

