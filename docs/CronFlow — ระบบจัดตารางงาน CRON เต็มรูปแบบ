def check_permission(self, job_id: str, user_id: str, action: str = "read") -> bool:
        """ตรวจสอบสิทธิ์: read/write/execute"""
        field = f"can_{action}"
        with self._connect() as conn:
            # เจ้าของ/ผู้ดูแลระบบเข้าได้ทุกงาน
            role = conn.execute("SELECT role FROM users WHERE user_id=?", (user_id,)).fetchone()
