"""
CronFlow — Status Dashboard
แสดงสถานะงาน · ประวัติ · กราฟ · ควบคุม
"""

from fastapi import FastAPI, Request
from fastapi.responses import HTMLResponse
from fastapi.templating import Jinja2Templates
from pathlib import Path
from datetime import datetime, timedelta
import json

app = FastAPI(title="CronFlow Dashboard")
templates = Jinja2Templates(directory="templates")

# เชื่อมต่อฐานข้อมูล
from cronflow_db import CronFlowDB
db = CronFlowDB("cronflow.db")


@app.get("/", response_class=HTMLResponse)
async def dashboard(request: Request):
    """หน้าหลักแดชบอร์ด"""
    with db._connect() as conn:
        # สถานภาพรวม
        active = conn.execute("SELECT COUNT(*) FROM jobs WHERE status='active'").fetchone()[0]
        paused = conn.execute("SELECT COUNT(*) FROM jobs WHERE status='paused'").fetchone()[0]
        failed = conn.execute("SELECT COUNT(*) FROM jobs WHERE last_status='failed'").fetchone()[0]

        # งานล่าสุด
        recent_runs = conn.execute("""
            SELECT r.*, j.name as job_name
            FROM job_runs r
            LEFT JOIN jobs j ON r.job_id = j.job_id
            ORDER BY started_at DESC LIMIT 15
        """).fetchall()

        # รายการงานทั้งหมด
        jobs = conn.execute("SELECT * FROM jobs ORDER BY created_at DESC").fetchall()

    return templates.TemplateResponse("dashboard.html", {
        "request": request,
        "active": active,
        "paused": paused,
        "failed": failed,
        "recent_runs": recent_runs,
        "jobs": jobs,
        "now": datetime.utcnow()
    })


@app.get("/api/jobs")
async def list_jobs():
    """API: รายการงานทั้งหมด"""
    with db._connect() as conn:
        rows = conn.execute("SELECT * FROM jobs ORDER BY created_at DESC").fetchall()
        return [dict(r) for r in rows]


@app.post("/api/jobs/{job_id}/toggle")
async def toggle_job(job_id: str):
    """เปลี่ยนสถานะ เปิด/ปิด"""
    with db._connect() as conn:
        cur = conn.cursor()
        cur.execute("SELECT status FROM jobs WHERE job_id=?", (job_id,))
        row = cur.fetchone()
        if not row:
            return {"ok": False, "error": "ไม่พบงาน"}
        new_status = "paused" if row[0] == "active" else "active"
        cur.execute("UPDATE jobs SET status=?, updated_at=? WHERE job_id=?",
                    (new_status, datetime.utcnow().isoformat(), job_id))
        return {"ok": True, "status": new_status}


@app.get("/api/runs/{job_id}")
async def job_history(job_id: str, limit: int = 20):
    """ประวัติการรันของงานนี้"""
    with db._connect() as conn:
        rows = conn.execute("""
            SELECT * FROM job_runs WHERE job_id=?
            ORDER BY started_at DESC LIMIT ?
        """, (job_id, limit)).fetchall()
        return [dict(r) for r in rows]
